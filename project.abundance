        {
          "atomType": "GitHubMolecule",
          "x": 0.24721734036321033,
          "y": 0.12944162436548223,
          "uniqueID": "id-3185",
          "name": "Nosecone_Haack_Series_notHollow",
          "ioValues": [
            {
              "name": "Length",
              "ioValue": 40,
              "currentEquation": "40"
            },
            {
              "name": "Outer_Diameter",
