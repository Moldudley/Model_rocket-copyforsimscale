        {
          "atomType": "GitHubMolecule",
          "x": 0.2577621558289397,
          "y": 0.12944162436548223,
          "uniqueID": "id-1328",
          "name": "Nosecone_Haack_Series",
          "ioValues": [
            {
              "name": "C",
              "ioValue": 0
            },
            {
              "name": "Outer_Diameter",
              "ioValue": 22
            },
            {
              "name": "Length",
              "ioValue": 40
            },
            {
              "name": "Wall_Thickness",
              "ioValue": 2
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 0.98,
              "y": 0.5,
              "uniqueID": "id-1322",
              "ioValues": [
                {
                  "name": "number or geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ]
            },
            {
              "atomType": "Code",
              "x": 0.27240773286467485,
              "y": 0.4898477157360406,
              "uniqueID": "id-1323",
              "ioValues": [
                {
                  "name": "length",
                  "ioValue": 40
                },
                {
                  "name": "outerDiameter",
                  "ioValue": 22
                },
                {
                  "name": "C",
                  "ioValue": 0
                },
                {
                  "name": "wallThickness",
                  "ioValue": 2
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\r\n * Hollow nose cone from the Haack series, equation-driven spline outer profile.\r\n * Solid of revolution around the Z axis; tip at z=0, base at z=length. Wall thickness is\r\n * applied radially (not a true perpendicular offset) — a standard, simple approximation.\r\n * length, outerDiameter, wallThickness in mm.\r\n * C sets the profile: 0 = LD-Haack / Von Karman (min drag for given length/diameter),\r\n * 0.333 = LV-Haack (min drag for given length/volume).\r\n */\r\nfunction run(\r\n  length: number = 100,\r\n  outerDiameter: number = 40,\r\n  C: number = 0,\r\n  wallThickness: number = 2,\r\n): Assembly {\r\n  const R = outerDiameter / 2;\r\n  const numPoints = Math.round(length * 3);\r\n\r\n  function radiusAt(x: number): number {\r\n    const theta = Math.acos(1 - (2 * x) / length);\r\n    return (\r\n      (R / Math.sqrt(Math.PI)) *\r\n      Math.sqrt(theta - Math.sin(2 * theta) / 2 + C * Math.pow(Math.sin(theta), 3))\r\n    );\r\n  }\r\n\r\n  function normalize(v: [number, number]): [number, number] {\r\n    const len = Math.hypot(v[0], v[1]);\r\n    return len === 0 ? [0, 0] : [v[0] / len, v[1] / len];\r\n  }\r\n\r\n  function buildOgiveProfile(radiusFn: (x: number) => number, extendTo?: number) {\r\n    const pts: [number, number][] = [[0, 0]];\r\n    for (let i = 1; i <= numPoints; i++) {\r\n      const x = (i / numPoints) * length;\r\n      pts.push([x, radiusFn(x)]);\r\n    }\r\n    const tans = pts.map((_, i) => {\r\n      const prev = pts[Math.max(0, i - 1)];\r\n      const next = pts[Math.min(pts.length - 1, i + 1)];\r\n      return normalize([next[0] - prev[0], next[1] - prev[1]]);\r\n    });\r\n\r\n    let pen = replicad.draw(pts[0]);\r\n    for (let i = 1; i < pts.length; i++) {\r\n      const [x0, y0] = pts[i - 1];\r\n      const [x1, y1] = pts[i];\r\n      const d = Math.hypot(x1 - x0, y1 - y0);\r\n      const t0 = tans[i - 1];\r\n      const t1 = tans[i];\r\n      const c1: [number, number] = [x0 + (t0[0] * d) / 3, y0 + (t0[1] * d) / 3];\r\n      const c2: [number, number] = [x1 - (t1[0] * d) / 3, y1 - (t1[1] * d) / 3];\r\n      pen = pen.cubicBezierCurveTo([x1, y1], c1, c2);\r\n    }\r\n\r\n    const [lastX, lastY] = pts[pts.length - 1];\r\n    if (extendTo !== undefined) {\r\n      pen = pen.lineTo([extendTo, lastY]).lineTo([extendTo, 0]);\r\n    } else {\r\n      pen = pen.lineTo([lastX, 0]);\r\n    }\r\n    return pen.close();\r\n  }\r\n\r\n  const outerProfile = buildOgiveProfile((x) => radiusAt(x));\r\n  const innerProfile = buildOgiveProfile(\r\n    (x) => Math.max(0, radiusAt(x) - wallThickness),\r\n    length + wallThickness,\r\n  );\r\n\r\n  const outerSolid = outerProfile.sketchOnPlane().revolve([1, 0, 0], { angle: 360 });\r\n  const innerSolid = innerProfile.sketchOnPlane().revolve([1, 0, 0], { angle: 360 });\r\n  console.log(\"about to do the cutting\")\r\n  const noseCone = outerSolid.cut(innerSolid).rotate(90, [0, 0, 0], [0, 1, 0]);\r\n  console.log(\"the cut finished\")\r\n\r\n  return new Assembly({\r\n    geometry: noseCone,\r\n    tags: [\"nose-cone\", \"haack-series\", \"hollow\"],\r\n    bom: [\r\n      `Haack series nose cone, length ${length}mm, outer diameter ${outerDiameter}mm, C=${C}, wall thickness ${wallThickness}mm`,\r\n    ],\r\n  });\r\n}",
              "compiledCode": "\"use strict\";\n/**\n * Hollow nose cone from the Haack series, equation-driven spline outer profile.\n * Solid of revolution around the Z axis; tip at z=0, base at z=length. Wall thickness is\n * applied radially (not a true perpendicular offset) — a standard, simple approximation.\n * length, outerDiameter, wallThickness in mm.\n * C sets the profile: 0 = LD-Haack / Von Karman (min drag for given length/diameter),\n * 0.333 = LV-Haack (min drag for given length/volume).\n */\nfunction run(length = 100, outerDiameter = 40, C = 0, wallThickness = 2) {\n    const R = outerDiameter / 2;\n    const numPoints = Math.round(length * 3);\n    function radiusAt(x) {\n        const theta = Math.acos(1 - (2 * x) / length);\n        return ((R / Math.sqrt(Math.PI)) *\n            Math.sqrt(theta - Math.sin(2 * theta) / 2 + C * Math.pow(Math.sin(theta), 3)));\n    }\n    function normalize(v) {\n        const len = Math.hypot(v[0], v[1]);\n        return len === 0 ? [0, 0] : [v[0] / len, v[1] / len];\n    }\n    function buildOgiveProfile(radiusFn, extendTo) {\n        const pts = [[0, 0]];\n        for (let i = 1; i <= numPoints; i++) {\n            const x = (i / numPoints) * length;\n            pts.push([x, radiusFn(x)]);\n        }\n        const tans = pts.map((_, i) => {\n            const prev = pts[Math.max(0, i - 1)];\n            const next = pts[Math.min(pts.length - 1, i + 1)];\n            return normalize([next[0] - prev[0], next[1] - prev[1]]);\n        });\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++) {\n            const [x0, y0] = pts[i - 1];\n            const [x1, y1] = pts[i];\n            const d = Math.hypot(x1 - x0, y1 - y0);\n            const t0 = tans[i - 1];\n            const t1 = tans[i];\n            const c1 = [x0 + (t0[0] * d) / 3, y0 + (t0[1] * d) / 3];\n            const c2 = [x1 - (t1[0] * d) / 3, y1 - (t1[1] * d) / 3];\n            pen = pen.cubicBezierCurveTo([x1, y1], c1, c2);\n        }\n        const [lastX, lastY] = pts[pts.length - 1];\n        if (extendTo !== undefined) {\n            pen = pen.lineTo([extendTo, lastY]).lineTo([extendTo, 0]);\n        }\n        else {\n            pen = pen.lineTo([lastX, 0]);\n        }\n        return pen.close();\n    }\n    const outerProfile = buildOgiveProfile((x) => radiusAt(x));\n    const innerProfile = buildOgiveProfile((x) => Math.max(0, radiusAt(x) - wallThickness), length + wallThickness);\n    const outerSolid = outerProfile.sketchOnPlane().revolve([1, 0, 0], { angle: 360 });\n    const innerSolid = innerProfile.sketchOnPlane().revolve([1, 0, 0], { angle: 360 });\n    console.log(\"about to do the cutting\");\n    const noseCone = outerSolid.cut(innerSolid).rotate(90, [0, 0, 0], [0, 1, 0]);\n    console.log(\"the cut finished\");\n    return new Assembly({\n        geometry: noseCone,\n        tags: [\"nose-cone\", \"haack-series\", \"hollow\"],\n        bom: [\n            `Haack series nose cone, length ${length}mm, outer diameter ${outerDiameter}mm, C=${C}, wall thickness ${wallThickness}mm`,\n        ],\n    });\n}\n"
            },
            {
              "atomType": "Input",
              "x": 0.025384615384615384,
              "y": 0.15384615384615385,
